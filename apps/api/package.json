{
  "name": "@taskora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "integrations:check": "tsx scripts/check-integrations.ts",
    "directory:cache:sync": "tsx scripts/sync-directory-cache.ts",
    "metrics:sync": "tsx scripts/sync-metrics.ts",
    "ga4:properties:sync": "tsx scripts/sync-ga4-properties.ts",
    "seed:directory": "tsx scripts/seed-directory-clients.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "wipe:firestore": "tsx scripts/wipe-firestore.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/sensible": "^5.2.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "firebase-admin": "^12.5.0",
    "google-auth-library": "^10.5.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "vitest": "^2.1.4"
  }
}
